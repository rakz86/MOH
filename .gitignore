# Dependencies
node_modules/

# Cloudflare Wrangler
.wrangler/
server/.dev.vars

# Secrets. Nothing here should ever be committed.
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Packaged builds — rebuild from source instead of committing binaries
*.zip

# Editor
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------------
# DELIBERATELY COMMITTED, though generated:
#
#   design-system/previews/*.html   built by tools/build.js
#   design-system/src/color.html    built by tools/gen-color.js
#   website/data/bundle.js          built by tools/bundle-data.py
#   design-system/assets/fonts/     downloaded by tools/fetch-fonts.py
#   design-system/assets/favicon/   generated by tools/make-favicons.py
#
# Keeping them in the repo means someone can clone and open the site without
# installing Node or Python first, and the demo works with no internet. The
# cost is noisier diffs when they are rebuilt, which is the right trade here.
#
# NOTE ON website/config.js: it is tracked because the app needs it to run,
# and `apiToken` is currently empty. The moment a real token goes in that
# field, committing it publishes the token. Split it before that happens.
# ---------------------------------------------------------------------------
